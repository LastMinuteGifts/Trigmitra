# Backend-only secrets will be added in later phases.
VITE_API_BASE_URL=http://localhost:4000/api
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.5-flash
# Fallback models (comma-separated) — pehla busy ho to agla try hota hai.
AI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# Keep this server-only. Never prefix it with VITE_.
AI_API_KEY=
# AI key na ho to demo solution chalega. Real AI ke liye false karo + key dalo.
DEMO_MODE=true
# Roz ka max AI solves (bill protection). Exceed ho to demo milta hai.
AI_DAILY_BUDGET=500
# Admin panel (server-only secrets — Render env me set karo):
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# ADMIN_SECRET=
